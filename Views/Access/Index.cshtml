@model events_access.ViewModels.AccessIndexViewModel

@{
Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Control de Acceso — CurtainCall</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Bricolage+Grotesque:wght@700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #fdf7ff;
            color: #1d1b20;
            height: 100vh;
            overflow: hidden;
        }

        /* ── Shell ── */
        .shell {
            display: grid;
            grid-template-columns: 260px 1fr;
            grid-template-rows: 64px 1fr;
            height: 100vh;
        }

        /* ── Sidebar ── */
        .sidebar {
            grid-row: 1 / 3;
            background: #f8f2fa;
            border-right: 1px solid #cbc4d2;
            display: flex;
            flex-direction: column;
            padding: 24px 12px;
            overflow-y: auto;
        }

        .sidebar-logo {
            font-family: 'Bricolage Grotesque', sans-serif;
            font-size: 22px;
            font-weight: 800;
            color: #4f378a;
            padding: 0 12px;
        }

        .sidebar-sub {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #7a7582;
            padding: 0 12px;
            margin-bottom: 28px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 14px;
            color: #494551;
            text-decoration: none;
            transition: background 0.15s;
            cursor: pointer;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
        }

        .nav-item:hover { background: #ece6ee; }
        .nav-item.active { background: rgba(103,80,164,0.15); color: #4f378a; font-weight: 700; }
        .nav-icon { font-size: 20px; }

        .sidebar-footer {
            margin-top: auto;
            padding-top: 20px;
            border-top: 1px solid #cbc4d2;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .btn-emergency {
            width: 100%;
            padding: 12px;
            background: #ba1a1a;
            color: #fff;
            border: none;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 700;
            font-family: inherit;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
        }

        .btn-emergency:hover { opacity: 0.9; }

        /* ── Topbar ── */
        .topbar {
            grid-column: 2;
            background: rgba(253,247,255,0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #cbc4d2;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
        }

        .topbar-title {
            font-family: 'Bricolage Grotesque', sans-serif;
            font-size: 20px;
            font-weight: 700;
        }

        .health-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #f2ecf4;
            border: 1px solid #cbc4d2;
            padding: 6px 14px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 600;
        }

        .health-dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: #7a7582;
            transition: background 0.3s;
        }

        .health-dot.ready    { background: #10b981; }
        .health-dot.error    { background: #ba1a1a; }
        .health-dot.scanning { background: #f59e0b; animation: blink 0.8s infinite; }

        @@keyframes blink {
            0%, 100% { opacity: 1; }
            50%       { opacity: 0.3; }
        }

        /* ── Canvas ── */
        .canvas {
            grid-column: 2;
            padding: 20px;
            overflow-y: auto;
            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 16px;
            align-content: start;
        }

        /* ── Panel base ── */
        .panel {
            background: #fff;
            border: 1px solid #e6e0e9;
            border-radius: 16px;
            padding: 20px;
        }

        .panel-title {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 14px;
        }

        /* ── Controls ── */
        .controls { display: flex; flex-direction: column; gap: 14px; }

        .field-label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: #7a7582;
            margin-bottom: 5px;
        }

        .form-input {
            width: 100%;
            padding: 9px 12px;
            border: 1.5px solid #cbc4d2;
            border-radius: 8px;
            font-size: 14px;
            font-family: inherit;
            background: #fdf7ff;
            color: #1d1b20;
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .form-input:focus {
            border-color: #6750a4;
            box-shadow: 0 0 0 3px rgba(103,80,164,0.12);
        }

        .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

        .qr-area {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid #6750a4;
            border-radius: 10px;
            font-size: 13px;
            font-family: monospace;
            background: #f8f2fa;
            color: #1d1b20;
            resize: none;
            outline: none;
            transition: box-shadow 0.15s;
        }

        .qr-area:focus { box-shadow: 0 0 0 4px rgba(103,80,164,0.15); }

        .btn-row { display: flex; gap: 8px; }

        .btn-scan {
            flex: 1;
            padding: 12px;
            background: #6750a4;
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background 0.15s, transform 0.1s;
        }

        .btn-scan:hover  { background: #4f378a; }
        .btn-scan:active { transform: scale(0.98); }

        .btn-clear {
            padding: 12px 16px;
            background: transparent;
            color: #7a7582;
            border: 1.5px solid #cbc4d2;
            border-radius: 10px;
            font-size: 18px;
            cursor: pointer;
            transition: background 0.15s;
        }

        .btn-clear:hover { background: #f2ecf4; }

        /* ── Columna derecha ── */
        .right-col { display: flex; flex-direction: column; gap: 14px; }

        /* ── Result card ── */
        .result-card {
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 36px 24px;
            text-align: center;
            transition: all 0.2s ease;
            background: #f2ecf4;
            border: 2px solid #e6e0e9;
            min-height: 240px;
        }

        .result-card[data-result="valid"]     { background: #064e3b; border-color: #10b981; }
        .result-card[data-result="duplicate"] { background: #78350f; border-color: #f59e0b; }
        .result-card[data-result="invalid"]   { background: #7f1d1d; border-color: #ef4444; }
        .result-card[data-result="error"]     { background: #1e293b; border-color: #475569; }

        .result-icon { font-size: 64px; color: #7a7582; margin-bottom: 10px; }
        .result-card[data-result="valid"]     .result-icon { color: #10b981; }
        .result-card[data-result="duplicate"] .result-icon { color: #f59e0b; }
        .result-card[data-result="invalid"]   .result-icon { color: #ef4444; }
        .result-card[data-result="error"]     .result-icon { color: #94a3b8; }

        .result-status {
            font-family: 'Bricolage Grotesque', sans-serif;
            font-size: 28px;
            font-weight: 800;
            color: #7a7582;
            margin-bottom: 6px;
        }

        .result-card[data-result="valid"]     .result-status,
        .result-card[data-result="duplicate"] .result-status,
        .result-card[data-result="invalid"]   .result-status,
        .result-card[data-result="error"]     .result-status { color: #fff; }

        .result-message { font-size: 14px; color: #7a7582; }
        .result-card[data-result="valid"]     .result-message,
        .result-card[data-result="duplicate"] .result-message,
        .result-card[data-result="invalid"]   .result-message,
        .result-card[data-result="error"]     .result-message { color: rgba(255,255,255,0.75); }

        /* ── Location ── */
        .location-card { background: #fff; border: 1px solid #e6e0e9; border-radius: 14px; padding: 16px; }

        .location-label {
            font-size: 11px; font-weight: 600; text-transform: uppercase;
            letter-spacing: 0.06em; color: #7a7582; margin-bottom: 10px;
        }

        .location-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }

        .location-item dt { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #7a7582; margin-bottom: 2px; }
        .location-item dd { font-size: 22px; font-weight: 800; font-family: 'Bricolage Grotesque', sans-serif; color: #1d1b20; }

        /* ── Meta chips ── */
        .scan-meta { display: flex; gap: 8px; flex-wrap: wrap; }
        .meta-chip { background: #f2ecf4; border: 1px solid #e6e0e9; border-radius: 999px; padding: 4px 12px; font-size: 12px; color: #494551; }

        /* ── History ── */
        .history-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .history-count { background: #6750a4; color: #fff; font-size: 12px; font-weight: 700; padding: 2px 10px; border-radius: 999px; }

        .history-list { display: flex; flex-direction: column; gap: 6px; max-height: 220px; overflow-y: auto; list-style: none; }

        .history-item {
            display: flex; align-items: center; gap: 10px;
            padding: 8px 12px; border-radius: 8px;
            background: #f8f2fa; border-left: 4px solid #cbc4d2; font-size: 12px;
        }

        .history-item.valid     { border-left-color: #10b981; }
        .history-item.duplicate { border-left-color: #f59e0b; }
        .history-item.invalid   { border-left-color: #ef4444; }
        .history-item.error     { border-left-color: #94a3b8; }

        .history-token { flex: 1; font-family: monospace; color: #494551; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .history-result { font-weight: 700; min-width: 80px; text-align: right; }
        .history-item.valid     .history-result { color: #10b981; }
        .history-item.duplicate .history-result { color: #f59e0b; }
        .history-item.invalid   .history-result { color: #ef4444; }
        .history-time { color: #7a7582; min-width: 55px; text-align: right; }

        /* ── Alert ── */
        .system-alert {
            grid-column: 1 / 3;
            background: #ffdad6; border: 1px solid #ba1a1a;
            border-radius: 10px; padding: 10px 14px;
            color: #93000a; font-size: 13px; font-weight: 600;
        }
    </style>
</head>
<body>
<div class="shell">

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-logo">CurtainCall</div>
        <p class="sidebar-sub">Palace Theater Operations</p>
        <nav style="display:flex;flex-direction:column;gap:4px;margin-bottom:16px;">
            <a class="nav-item active">
                <span class="material-symbols-outlined nav-icon">person_pin_circle</span>
                Control de Acceso
            </a>
            <a class="nav-item" href="#">
                <span class="material-symbols-outlined nav-icon">space_dashboard</span>
                Dashboard
            </a>
            <a class="nav-item" href="#">
                <span class="material-symbols-outlined nav-icon">confirmation_number</span>
                Taquilla
            </a>
            <a class="nav-item" href="#">
                <span class="material-symbols-outlined nav-icon">diversity_3</span>
                Staff
            </a>
        </nav>
        <div class="sidebar-footer">
            <button class="btn-emergency">
                <span class="material-symbols-outlined">warning</span>
                Alerta de Emergencia
            </button>
        </div>
    </aside>

    <!-- Topbar -->
    <header class="topbar">
        <span class="topbar-title">Panel de Acomodación</span>
        <div class="health-badge">
            <span class="health-dot" id="healthDot"></span>
            <span id="healthText">Inicializando...</span>
        </div>
    </header>

    <!-- Canvas -->
    <main class="canvas">

        @if (!string.IsNullOrWhiteSpace(Model.ApiError))
        {
        <div class="system-alert">⚠ @Model.ApiError</div>
        }

        <!-- Controls -->
        <div class="panel controls">
            <div class="panel-title">Escáner de Acceso</div>

            <div>
                <label class="field-label" for="eventSelect">Evento activo</label>
                <select id="eventSelect" class="form-input">
                    <option value="">Todos los eventos del día</option>
                    @foreach (var evento in Model.Eventos)
                    {
                    <option value="@evento.IdEvento">@evento.NombreEvento</option>
                    }
                </select>
            </div>

            <div class="field-row">
                <div>
                    <label class="field-label" for="staffId">ID Empleado</label>
                    <input id="staffId" class="form-input" type="number" min="1" value="1" inputmode="numeric" />
                </div>
                <div>
                    <label class="field-label" for="deviceName">Dispositivo</label>
                    <input id="deviceName" class="form-input" value="Acceso principal" />
                </div>
            </div>

            <div>
                <label class="field-label" for="qrInput">Lectura QR</label>
                <textarea id="qrInput" class="qr-area" rows="3"
                          autocomplete="off" spellcheck="false"
                          placeholder="Escanea con la pistola o pega el token..."></textarea>
            </div>

            <div class="btn-row">
                <button id="scanButton" class="btn-scan" type="button">
                    <span class="material-symbols-outlined">qr_code_scanner</span>
                    Validar entrada
                </button>
                <button id="clearButton" class="btn-clear" type="button" title="Limpiar">×</button>
            </div>
        </div>

        <!-- Columna derecha -->
        <div class="right-col">

            <!-- Result -->
            <div class="result-card" id="resultCard" data-result="idle">
                <span class="material-symbols-outlined result-icon" id="resultIcon">qr_code_scanner</span>
                <div class="result-status" id="resultStatus">Esperando QR</div>
                <div class="result-message" id="resultMessage">Escanea un código para comenzar.</div>
            </div>

            <!-- Location -->
            <div class="location-card">
                <p class="location-label">Ubicación del asiento</p>
                <div class="location-grid">
                    <div class="location-item"><dt>Sección</dt><dd id="locSection">--</dd></div>
                    <div class="location-item"><dt>Fila</dt><dd id="locRow">--</dd></div>
                    <div class="location-item"><dt>Asiento</dt><dd id="locSeat">--</dd></div>
                </div>
            </div>

            <!-- Meta -->
            <div class="scan-meta">
                <span class="meta-chip" id="metaLatency">-- ms</span>
                <span class="meta-chip" id="metaTicket">Ticket --</span>
                <span class="meta-chip" id="metaScan">Registro --</span>
            </div>

            <!-- History -->
            <div class="panel">
                <div class="history-header">
                    <span class="panel-title" style="margin:0">Lecturas recientes</span>
                    <span class="history-count" id="historyCount">0</span>
                </div>
                <ol id="historyList" class="history-list"></ol>
            </div>

        </div>
    </main>
</div>

<script>
    (() => {
        const qrInput      = document.getElementById('qrInput');
        const scanBtn      = document.getElementById('scanButton');
        const clearBtn     = document.getElementById('clearButton');
        const resultCard   = document.getElementById('resultCard');
        const resultIcon   = document.getElementById('resultIcon');
        const resultStatus = document.getElementById('resultStatus');
        const resultMsg    = document.getElementById('resultMessage');
        const locSection   = document.getElementById('locSection');
        const locRow       = document.getElementById('locRow');
        const locSeat      = document.getElementById('locSeat');
        const metaLatency  = document.getElementById('metaLatency');
        const metaTicket   = document.getElementById('metaTicket');
        const metaScan     = document.getElementById('metaScan');
        const historyList  = document.getElementById('historyList');
        const historyCount = document.getElementById('historyCount');
        const healthDot    = document.getElementById('healthDot');
        const healthText   = document.getElementById('healthText');

        let total = 0;
        const configIds = ['eventSelect', 'staffId', 'deviceName'];

        // Mantener foco en QR
        function keepFocus() {
            if (!configIds.includes(document.activeElement?.id)) qrInput.focus();
        }
        document.addEventListener('click', e => { if (!configIds.includes(e.target.id)) keepFocus(); });
        setInterval(keepFocus, 600);
        keepFocus();

        // Enter del scanner
        qrInput.addEventListener('keydown', async e => {
            if (e.key === 'Enter') {
                e.preventDefault();
                const token = qrInput.value.trim();
                if (token) await scan(token);
            }
        });

        scanBtn.addEventListener('click', async () => {
            const token = qrInput.value.trim();
            if (token) await scan(token);
        });

        clearBtn.addEventListener('click', () => {
            qrInput.value = '';
            resetResult();
            keepFocus();
        });

        async function scan(token) {
            setHealth('scanning', 'Validando...');
            resultCard.dataset.result = 'idle';
            resultIcon.textContent    = 'sync';
            resultStatus.textContent  = 'Validando...';
            resultMsg.textContent     = '';

            const body = {
                qrPayload:   token,
                idEmpleado:  parseInt(document.getElementById('staffId').value) || 1,
                idEvento:    parseInt(document.getElementById('eventSelect').value) || null,
                dispositivo: document.getElementById('deviceName').value || 'Acceso principal'
            };

            try {
                const res  = await fetch('/access/scan', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify(body)
                });
                const data = await res.json();
                mostrar(data, token);
                setHealth('ready', 'Scanner listo');
            } catch {
                mostrarError('Sin conexión con el servidor', token);
                setHealth('error', 'Sin conexión');
            }

            qrInput.value = '';
        }

        function mostrar(data, token) {
            const r = (data.resultado ?? 'ERROR').toUpperCase();
            const cfg = {
                'VALIDO':    { state: 'valid',     icon: 'check_circle', status: 'ACCESO APROBADO',  css: 'valid'     },
                'DUPLICADO': { state: 'duplicate',  icon: 'warning',      status: 'QR YA UTILIZADO',  css: 'duplicate' },
                'INVALIDO':  { state: 'invalid',    icon: 'cancel',       status: 'ACCESO DENEGADO',  css: 'invalid'   },
            }[r] ?? { state: 'error', icon: 'error', status: 'ERROR', css: 'error' };

            resultCard.dataset.result = cfg.state;
            resultIcon.textContent    = cfg.icon;
            resultStatus.textContent  = cfg.status;
            resultMsg.textContent     = data.mensaje ?? '';

            locSection.textContent = data.seccion  ?? '--';
            locRow.textContent     = data.fila      ?? '--';
            locSeat.textContent    = data.asiento   ?? '--';

            metaLatency.textContent = data.latenciaMs != null ? `${data.latenciaMs} ms` : '-- ms';
            metaTicket.textContent  = data.idTicket  != null ? `Ticket #${data.idTicket}` : 'Ticket --';
            metaScan.textContent    = data.idScan    != null ? `Registro #${data.idScan}`  : 'Registro --';

            addHistory(token, r, cfg.css);
        }

        function mostrarError(msg, token) {
            resultCard.dataset.result = 'error';
            resultIcon.textContent    = 'wifi_off';
            resultStatus.textContent  = 'SIN CONEXIÓN';
            resultMsg.textContent     = msg;
            addHistory(token, 'ERROR', 'error');
        }

        function resetResult() {
            resultCard.dataset.result = 'idle';
            resultIcon.textContent    = 'qr_code_scanner';
            resultStatus.textContent  = 'Esperando QR';
            resultMsg.textContent     = 'Escanea un código para comenzar.';
            locSection.textContent = locRow.textContent = locSeat.textContent = '--';
            metaLatency.textContent = '-- ms';
            metaTicket.textContent  = 'Ticket --';
            metaScan.textContent    = 'Registro --';
        }

        function addHistory(token, resultado, css) {
            total++;
            historyCount.textContent = total;
            const hora = new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            const li = document.createElement('li');
            li.className = `history-item ${css}`;
            li.innerHTML = `<span class="history-token">${token}</span><span class="history-result">${resultado}</span><span class="history-time">${hora}</span>`;
            historyList.prepend(li);
            while (historyList.children.length > 10) historyList.removeChild(historyList.lastChild);
        }

        function setHealth(state, text) {
            healthDot.className    = `health-dot ${state}`;
            healthText.textContent = text;
        }

        // Ping inicial
        fetch('/access/scan', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
            .then(() => setHealth('ready', 'Scanner listo'))
            .catch(() => setHealth('error', 'API no disponible'));
    })();
</script>
</body>
</html>
